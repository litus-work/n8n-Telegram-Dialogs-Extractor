    {
      "parameters": {
        "language": "python",
        "pythonCode": "import re\n\nresults = []\n\nfor item in items:\n    filename = item[\"binary\"][\"data\"][\"fileName\"]\n    \n    match = re.search(r\"(\\d{2})-(\\d{2})-(\\d{4})_(\\d{2})-(\\d{2})-(\\d{2})\", filename)\n\n    if match:\n        date_str = f\"{match.group(1)}.{match.group(2)}.{match.group(3)}\"\n        time_str = f\"{match.group(4)}:{match.group(5)}:{match.group(6)}\"\n        dt_str = f\"{date_str} {time_str}\"\n    else:\n        dt_str = \"неизвестно\"\n\n    item[\"json\"][\"datetime\"] = dt_str\n    results.append(item)\n\nreturn results\n"
      },
